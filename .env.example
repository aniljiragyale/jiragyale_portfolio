# Copy to .env and fill in your values ( .env is gitignored )

# EmailJS — https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Admin portal ( /admin ) — local dev (npm run dev)
VITE_ADMIN_USERNAME=your_username
VITE_ADMIN_PASSWORD=your_secure_password

# Production (Vercel → Settings → Environment Variables) — server-only, not bundled in JS
# ADMIN_USERNAME=your_username
# ADMIN_PASSWORD=your_secure_password

# Contact form + ratings → saved as Excel (portfolio-submissions.xlsx) + shown in admin
# Vercel Dashboard → Storage → Create Database → KV (or Redis) → Connect → Redeploy
# (Adds KV_REST_API_URL and KV_REST_API_TOKEN — Excel file is stored inside KV)
